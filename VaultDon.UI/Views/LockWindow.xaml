<Window x:Class="VaultDon.UI.Views.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VAULTDON" Height="420" Width="400"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Border CornerRadius="14" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#141E30" Offset="0"/>
                <GradientStop Color="#1E293B" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#9938BDF8" Offset="0"/>
                <GradientStop Color="#FF334155" Offset="0.5"/>
                <GradientStop Color="#66818CF8" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <!-- Custom title bar -->
            <Border VerticalAlignment="Top" Height="42" CornerRadius="14,14,0,0"
                    MouseDown="TitleBar_MouseDown" Background="Transparent">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <!-- Inline padlock icon -->
                        <Canvas Width="16" Height="16" Margin="0,0,8,0">
                            <Path Canvas.Left="3" Canvas.Top="7"
                                  Fill="{StaticResource AccentBrush}"
                                  Data="M 0,0 H 10 A 1.5,1.5 0 0 1 11.5,1.5 V 7 A 1.5,1.5 0 0 1 10,8.5 H 0 A 1.5,1.5 0 0 1 -1.5,7 V 1.5 A 1.5,1.5 0 0 1 0,0 Z"/>
                            <Path Canvas.Left="4" Canvas.Top="1"
                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.4"
                                  Fill="Transparent"
                                  Data="M 0,6 L 0,3 A 3.5,3.5 0 0 1 7,3 L 7,6"/>
                        </Canvas>
                        <TextBlock Text="VAULTDON" Foreground="{StaticResource AccentBrush}"
                                   FontWeight="Bold" FontSize="13" VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>
                    <Button Content="✕" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Click="Close_Click" FontSize="12" Padding="6,4"/>
                </Grid>
            </Border>

            <!-- Main content -->
            <StackPanel VerticalAlignment="Center" Margin="44,42,44,32">

                <!-- Logo -->
                <Canvas Width="68" Height="68" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <!-- Glow circle -->
                    <Ellipse Width="68" Height="68" Opacity="0.12">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#38BDF8" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <!-- Background circle -->
                    <Ellipse Width="58" Height="58" Canvas.Left="5" Canvas.Top="5">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1E3A5F" Offset="0"/>
                                <GradientStop Color="#1E293B" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#38BDF8" Offset="0"/>
                                <GradientStop Color="#818CF8" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Stroke>
                        <Ellipse.StrokeThickness>1.5</Ellipse.StrokeThickness>
                    </Ellipse>
                    <!-- Padlock body -->
                    <Path Canvas.Left="20" Canvas.Top="37" Fill="{StaticResource AccentBrush}">
                        <Path.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="0,0" IsClosed="True">
                                    <LineSegment Point="28,0"/>
                                    <ArcSegment Point="28,16" Size="2,2" SweepDirection="Clockwise"/>
                                    <LineSegment Point="0,16"/>
                                    <ArcSegment Point="0,0" Size="2,2" SweepDirection="Clockwise"/>
                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                    </Path>
                    <!-- Padlock shackle -->
                    <Path Canvas.Left="23" Canvas.Top="17" Stroke="{StaticResource AccentBrush}"
                          StrokeThickness="3" Fill="Transparent" StrokeLineJoin="Round">
                        <Path.Data>M 0,20 L 0,8 A 11,11 0 0 1 22,8 L 22,20</Path.Data>
                    </Path>
                    <!-- Keyhole -->
                    <Ellipse Width="6" Height="6" Canvas.Left="31" Canvas.Top="43" Fill="#0F172A"/>
                    <Rectangle Width="3" Height="5" Canvas.Left="32.5" Canvas.Top="49" Fill="#0F172A" RadiusX="1" RadiusY="1"/>
                </Canvas>

                <TextBlock x:Name="TitleLabel" Text="Unlock Vault"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="22" FontWeight="Bold" FontFamily="Segoe UI"
                           HorizontalAlignment="Center" Margin="0,16,0,4"/>
                <TextBlock x:Name="SubLabel" Text="Enter your master password"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="13" FontFamily="Segoe UI"
                           HorizontalAlignment="Center" Margin="0,0,0,28"/>

                <!-- Password input -->
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource DarkPasswordBox}"
                             KeyDown="PasswordBox_KeyDown" Margin="0,0,0,10"
                             FontSize="14"/>
                <PasswordBox x:Name="ConfirmBox" Style="{StaticResource DarkPasswordBox}"
                             KeyDown="PasswordBox_KeyDown" Margin="0,0,0,10"
                             Visibility="Collapsed" ToolTip="Confirm master password"
                             FontSize="14"/>

                <!-- Error -->
                <Border x:Name="ErrorBorder" Visibility="Collapsed" Background="#2D1515"
                        BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                    <TextBlock x:Name="ErrorLabel" Foreground="{StaticResource DangerBrush}"
                               FontSize="12" FontFamily="Segoe UI" TextWrapping="Wrap"/>
                </Border>

                <!-- Unlock button -->
                <Button x:Name="UnlockButton" Content="Unlock" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch" Click="Unlock_Click"
                        FontSize="14" Padding="20,12" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
