<Window x:Class="VaultDon.UI.Views.EntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VaultDon.UI.ViewModels"
        Title="Entry" Height="540" Width="460"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:InverseBoolToVisConverter x:Key="InverseBoolToVis"/>
    </Window.Resources>

    <Border CornerRadius="12" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#141E30" Offset="0"/>
                <GradientStop Color="#1E293B" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#6638BDF8" Offset="0"/>
                <GradientStop Color="#FF334155" Offset="0.5"/>
                <GradientStop Color="#4D818CF8" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="66"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" MouseDown="TitleBar_MouseDown"
                    Background="Transparent">
                <Grid Margin="20,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✏" FontSize="14" Margin="0,0,10,0"
                                   VerticalAlignment="Center" Opacity="0.7"/>
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="SemiBold" FontSize="15"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding CancelCommand}"
                            Padding="8,5" FontSize="12"/>
                </Grid>
            </Border>

            <!-- Thin accent line under title -->
            <Rectangle Grid.Row="0" VerticalAlignment="Bottom" Height="1" Margin="20,0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#8038BDF8" Offset="0"/>
                        <GradientStop Color="#00334155" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Padding="0,0,2,0">
                <StackPanel Margin="22,20,22,8">

                    <!-- Company / Category -->
                    <TextBlock Text="COMPANY / CATEGORY" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource DarkTextBox}"
                             Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16"/>

                    <!-- Label -->
                    <TextBlock Text="LABEL" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource DarkTextBox}"
                             Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16"/>

                    <!-- Username / Email -->
                    <TextBlock Text="USERNAME / EMAIL" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource DarkTextBox}"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16"/>

                    <!-- Password -->
                    <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,16">
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                 x:Name="PasswordPlain"
                                 Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}}"
                                 Padding="12,10,42,10"/>
                        <PasswordBox Style="{StaticResource DarkPasswordBox}"
                                     x:Name="PasswordHidden"
                                     Visibility="{Binding ShowPassword, Converter={StaticResource InverseBoolToVis}}"
                                     Padding="12,10,42,10"/>
                        <Button Style="{StaticResource IconButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,6,0"
                                Command="{Binding TogglePasswordCommand}"
                                ToolTip="Show/Hide password"
                                Width="32" Height="32">
                            <TextBlock Text="👁" FontSize="14"/>
                        </Button>
                    </Grid>

                    <!-- URL -->
                    <TextBlock Text="URL (OPTIONAL)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource DarkTextBox}"
                             Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16"/>

                    <!-- Notes -->
                    <TextBlock Text="NOTES (OPTIONAL)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource DarkTextBox}"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             Height="72" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Margin="0,0,0,4"/>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer buttons -->
            <Border Grid.Row="2" BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource BorderBrush}"
                    CornerRadius="0,0,12,12" Background="Transparent">
                <Grid Margin="22,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="Cancel" Style="{StaticResource GhostButton}"
                                Margin="0,0,10,0" Padding="16,9"
                                Command="{Binding CancelCommand}"/>
                        <Button Style="{StaticResource PrimaryButton}" Padding="20,9"
                                Command="{Binding SaveCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Save" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
