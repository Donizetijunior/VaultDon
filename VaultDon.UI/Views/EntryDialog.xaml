<Window x:Class="VaultDon.UI.Views.EntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VaultDon.UI.ViewModels"
        Title="Entry" Height="510" Width="440"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:InverseBoolToVisConverter x:Key="InverseBoolToVis"/>
    </Window.Resources>
    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{StaticResource BgBrush}" CornerRadius="10,10,0,0"
                    MouseDown="TitleBar_MouseDown">
                <Grid Margin="16,0">
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}"
                               FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                    <Button Content="✕" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                            Command="{Binding CancelCommand}"/>
                </Grid>
            </Border>

            <!-- Form -->
            <StackPanel Grid.Row="1" Margin="20,16">
                <TextBlock Text="Company / Category" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="Label" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="Username / Email" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="Password" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             x:Name="PasswordPlain" Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}}"/>
                    <PasswordBox Style="{StaticResource DarkPasswordBox}" x:Name="PasswordHidden"
                                 Visibility="{Binding ShowPassword, Converter={StaticResource InverseBoolToVis}}"/>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,4,0" Command="{Binding TogglePasswordCommand}" Content="👁" ToolTip="Show/Hide"/>
                </Grid>

                <TextBlock Text="URL (optional)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="Notes (optional)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <!-- Buttons -->
            <Grid Grid.Row="2" Margin="20,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                            Command="{Binding CancelCommand}"/>
                    <Button Content="Save" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
