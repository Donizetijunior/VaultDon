<Window x:Class="VaultDon.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VaultDon.UI.ViewModels"
        Title="VAULTDON" Height="680" Width="1050"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:InverseBoolToVisConverter x:Key="InverseBoolToVis"/>
        <vm:NullToVisibilityConverter x:Key="NullToVis"/>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}" CornerRadius="10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="10,10,0,0" MouseDown="TitleBar_MouseDown">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔐" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="VAULTDON" Foreground="{StaticResource AccentBrush}"
                                   FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Drive ↑" Style="{StaticResource GhostButton}" Margin="0,0,4,0"
                                Command="{Binding BackupToDriveCommand}" ToolTip="Backup to Google Drive"/>
                        <Button Content="Drive ↓" Style="{StaticResource GhostButton}" Margin="0,0,12,0"
                                Command="{Binding RestoreFromDriveCommand}" ToolTip="Restore from Google Drive"/>
                        <Button Content="─" Style="{StaticResource GhostButton}" Margin="0,0,4,0"
                                Click="Minimize_Click"/>
                        <Button Content="✕" Style="{StaticResource GhostButton}"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Grid Grid.Column="0" Background="{StaticResource SurfaceBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="CATEGORIES" Foreground="{StaticResource MutedBrush}"
                               FontSize="10" FontWeight="SemiBold" Margin="16,16,0,8"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Companies}"
                             SelectedItem="{Binding SelectedCompany}"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource SidebarItem}"
                             Margin="8,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="13"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" Content="Clear Filter" Style="{StaticResource GhostButton}"
                            Margin="8,8" HorizontalAlignment="Stretch"
                            Command="{Binding ClearFilterCommand}"/>
                </Grid>

                <!-- Divider -->
                <Border Grid.Column="1" Background="{StaticResource BorderBrush}"/>

                <!-- Entry list -->
                <Grid Grid.Column="2" Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,110,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Escape" Command="{Binding ClearFilterCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="Search..." Foreground="{StaticResource MutedBrush}" FontSize="13"
                                   Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="+ Add Entry" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right" Command="{Binding AddEntryCommand}"/>
                    </Grid>

                    <!-- Entries -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                                            Margin="0,0,0,8" Padding="16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Company}" Foreground="{StaticResource AccentBrush}"
                                                               FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextBrush}"
                                                               FontSize="14" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <!-- Username row -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Text="👤" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Username}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                                    <Button Style="{StaticResource IconButton}" Content="⎘" ToolTip="Copy Username"
                                                            Command="{Binding DataContext.CopyUsernameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Margin="6,0,0,0"/>
                                                </StackPanel>
                                                <!-- Password row -->
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔑" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="••••••••" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                                    <Button Style="{StaticResource IconButton}" Content="⎘" ToolTip="Copy Password"
                                                            Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Margin="6,0,0,0"/>
                                                </StackPanel>
                                                <!-- URL -->
                                                <TextBlock Text="{Binding Url}" Foreground="{StaticResource MutedBrush}"
                                                           FontSize="11" Margin="0,4,0,0" Opacity="0.7"
                                                           Visibility="{Binding Url, Converter={StaticResource NullToVis}}"/>
                                            </StackPanel>
                                            <!-- Actions -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Style="{StaticResource GhostButton}" Content="🚀" ToolTip="Abrir site e preencher automaticamente"
                                                        Command="{Binding DataContext.LaunchEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding Url, Converter={StaticResource NullToVis}}"/>
                                                <Button Style="{StaticResource GhostButton}" Content="✏" ToolTip="Edit"
                                                        Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource DangerButton}" Content="🗑" ToolTip="Delete"
                                                        Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="0,0,10,10">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}"
                           FontSize="11" VerticalAlignment="Center" Margin="16,0"/>
            </Border>
        </Grid>
    </Border>
</Window>
